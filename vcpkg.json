{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "unrealvoxelsim-testbed-qt",
  "version-string": "0.1.0",
  "dependencies": [
    "entt",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "opengl",
        "widgets"
      ]
    }
  ],
  "features": {
    "profiling-tracy": {
      "description": "Enable the on-demand Tracy client and command-line capture tools used by profiling builds.",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "cli-tools",
            "on-demand"
          ]
        }
      ]
    }
  }
}
